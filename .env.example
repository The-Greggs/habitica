# Environment Configuration for Habitica Action History Deployment
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env with real passwords to git!

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# For Gmail, you need to use an App Password, not your regular password
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_gmail_app_password_here

# =============================================================================
# SESSION SECURITY
# =============================================================================
# Generate strong random values using these commands:
# SESSION_SECRET: openssl rand -base64 32
# SESSION_SECRET_IV: openssl rand -hex 16
# SESSION_SECRET_KEY: openssl rand -hex 32

SESSION_SECRET=CHANGE_ME_minimum_32_characters_long
SESSION_SECRET_IV=CHANGE_ME_32_hex_characters
SESSION_SECRET_KEY=CHANGE_ME_64_hex_characters

# =============================================================================
# OPTIONAL: DATABASE CONFIGURATION
# =============================================================================
# Uncomment and modify if you want to use external MongoDB
# NODE_DB_URI=mongodb://external-mongo:27017/habitica

# =============================================================================
# OPTIONAL: ADDITIONAL SETTINGS
# =============================================================================
# Uncomment to override defaults

# Maximum number of database connections
# MONGODB_POOL_SIZE=10

# Database socket timeout in milliseconds
# MONGODB_SOCKET_TIMEOUT=20000

# Number of worker processes (typically 1 for small deployments)
# WEB_CONCURRENCY=1

# Enable detailed logging in production
# ENABLE_CONSOLE_LOGS_IN_PROD=true

# Disable request logging for better performance
# DISABLE_REQUEST_LOGGING=true
